# Telegram bot token (BotFather থেকে নেওয়া) — কাউকে দেবেন না, চ্যাটে পাঠাবেন না
BOT_TOKEN=

# বটের মালিকের Telegram user id — শুধু এই id-ই /activate চালাতে পারবে।
# নিজের id জানতে Telegram-এ @userinfobot খুলে /start দিন, id টি দেখাবে।
OWNER_ID=

# পেজ প্রকাশের ধরন: "local" (শুধু পরীক্ষার জন্য, কম্পিউটারে ফাইল বানাবে)
# অথবা "github" (আসল লিংক দেবে — GitHub Pages ব্যবহার করবে)
LINK_MODE=local

# GitHub মোডের জন্য (LINK_MODE=github হলে এগুলো লাগবে)
GITHUB_TOKEN=
GITHUB_REPO=username/repo-name
GITHUB_BRANCH=main
PAGES_BASE_URL=https://username.github.io/repo-name
